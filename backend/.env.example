# Port the NestJS server listens on
PORT=3001

# Allowed origin for CORS (the Next.js frontend)
FRONTEND_URL=http://localhost:3000

# Optional GitHub Personal Access Token.
# Used ONLY on the server to raise the GitHub API rate limit (60/h -> 5000/h).
# Leave empty to work unauthenticated. NEVER expose this to the frontend.
GITHUB_TOKEN=
